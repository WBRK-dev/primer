#!/usr/bin/env bash
set -e

(cd kernel && cargo build)
objcopy -O binary kernel/target/i686-primer/debug/kernel kernel/target/i686-primer/debug/kernel.bin
KERNEL_BYTES=$(stat -c %s kernel/target/i686-primer/debug/kernel.bin)
KERNEL_SECTORS=$(( (KERNEL_BYTES + 511) / 512 ))
truncate -s $(($KERNEL_SECTORS * 512)) kernel/target/i686-primer/debug/kernel.bin

nasm -f bin boot/main.asm -o boot/main.bin
nasm -f bin boot/stage2.asm -o boot/stage2.bin -DKERNEL_SECTORS=$KERNEL_SECTORS
nasm -f bin boot/fake_kernel.asm -o boot/fake_kernel.bin

cat boot/main.bin boot/stage2.bin kernel/target/i686-primer/debug/kernel.bin > boot/image.bin

qemu-system-i386 -drive format=raw,file=boot/image.bin
